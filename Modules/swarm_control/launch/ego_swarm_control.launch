<launch>
  <arg name="swarm_num" default="1"/>
  <arg name="uav_id" default="1"/>
  <arg name="enable_world_frame" default="false"/>
  <arg name="uav_init_x" default="0.0"/>
  <arg name="uav_init_y" default="0.0"/>
  <arg name="uav_init_z" default="0.0"/>
  <arg name="uav_init_yaw" default="0.0"/>
  <arg name="input_source" default="4"/>
  <arg name="takeoff_height" default="1.2"/>
  <arg name="enable_mission_gate" default="true"/>
  <arg name="frame_adapter_config" default="$(find prometheus_swarm_control)/launch/frame_adapter.yaml"/>
  <!-- Sensor/vision compensation is independent of the inter-UAV initial placement. -->
  <arg name="vision_offset_x" default="0.0"/>
  <arg name="vision_offset_y" default="0.0"/>
  <arg name="vision_offset_z" default="0.0"/>

  <node pkg="prometheus_swarm_control" type="swarm_estimator" name="swarm_estimator_uav_$(arg uav_id)" output="screen">
    <param name="uav_id" value="$(arg uav_id)"/>
    <param name="input_source" value="$(arg input_source)"/>
    <param name="offset_x" value="$(eval arg('vision_offset_x') if arg('enable_world_frame') else arg('uav_init_x'))"/>
    <param name="offset_y" value="$(eval arg('vision_offset_y') if arg('enable_world_frame') else arg('uav_init_y'))"/>
    <param name="offset_z" value="$(eval arg('vision_offset_z') if arg('enable_world_frame') else arg('uav_init_z'))"/>
    <param name="fastlio_frame" value="$(eval 'uav'+str(arg('uav_id'))+'/lio_init' if arg('enable_world_frame') else 'world')"/>
    <param name="state_frame" value="$(eval 'uav'+str(arg('uav_id'))+'/fcu_local' if arg('enable_world_frame') else 'world')"/>
    <param name="publish_visualization" value="$(eval not arg('enable_world_frame'))"/>
    <remap from="/drone_Odom_high_freq" to="/uav$(arg uav_id)/drone_Odom_high_freq"/>
    <remap from="/uav$(arg uav_id)/prometheus/drone_state"
           to="$(eval '/uav'+str(arg('uav_id'))+('/local/drone_state' if arg('enable_world_frame') else '/prometheus/drone_state'))"/>
  </node>

  <node if="$(arg enable_world_frame)" pkg="prometheus_swarm_control" type="swarm_frame_adapter"
        name="swarm_frame_adapter_uav_$(arg uav_id)" output="screen" required="true">
    <rosparam command="load" file="$(arg frame_adapter_config)"/>
    <param name="uav_id" value="$(arg uav_id)"/>
    <param name="init_x" value="$(arg uav_init_x)"/>
    <param name="init_y" value="$(arg uav_init_y)"/>
    <param name="init_z" value="$(arg uav_init_z)"/>
    <param name="init_yaw" value="$(arg uav_init_yaw)"/>
  </node>

  <node pkg="prometheus_swarm_control" type="swarm_controller" name="swarm_controller_uav_$(arg uav_id)" output="screen">
    <param name="swarm_num" value="$(arg swarm_num)"/>
    <param name="uav_id" value="$(arg uav_id)"/>
    <param name="controller_flag" value="1"/>
    <param name="controller_hz" value="50.0"/>
    <param name="takeoff_height" value="$(arg takeoff_height)"/>
    <param name="require_frame_ready" value="$(arg enable_world_frame)"/>
    <rosparam command="load" file="$(find prometheus_swarm_control)/launch/ego_control_lidar_config.yaml"/>
    <param if="$(arg enable_world_frame)" name="drift_correction/enable" value="false"/>
    <remap from="/uav$(arg uav_id)/mavros/setpoint_raw/local"
           to="$(eval '/uav'+str(arg('uav_id'))+('/world/setpoint_raw/local' if arg('enable_world_frame') else '/mavros/setpoint_raw/local'))"/>
  </node>

  <node pkg="prometheus_swarm_control" type="ego_traj_to_cmd" name="ego_traj_to_cmd_uav_$(arg uav_id)" output="screen">
    <param name="swarm_num" value="$(arg swarm_num)"/>
    <param name="uav_id" value="$(arg uav_id)"/>
    <param name="control_flag" value="0"/>
    <param name="enable_mission_gate" value="$(arg enable_mission_gate)"/>
    <param name="require_frame_ready" value="$(arg enable_world_frame)"/>
    <param name="takeoff_height" value="$(arg takeoff_height)"/>
  </node>
</launch>
