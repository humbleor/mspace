<launch>
  <!-- ========================================================================
       3 UAV LiDAR Detect Simulation Launch File
       基于树干特征匹配的森林场景多机相对定位 (3机 + 因子图优化)
       ======================================================================== -->

  <arg name="use_gpu_" value="false"/>

  <!-- 地图尺寸 -->
  <arg name="map_size_x" value="100.0"/>
  <arg name="map_size_y" value="100.0"/>
  <arg name="map_size_z" value="10.0"/>

  <!-- 无人机 ID -->
  <arg name="uav_id_1" value="1"/>
  <arg name="uav_id_2" value="2"/>
  <arg name="uav_id_3" value="3"/>
  <arg name="uav_num" value="3"/>

  <!-- 初始位置 -->
  <arg name="init_x" value="0.0"/>
  <arg name="init_y" value="0.0"/>
  <arg name="init_z" value="0.1"/>

  <arg name="frame_id" value="world"/>
  <arg name="global_cloud_topic" value="/map_generator/global_cloud"/>
  <arg name="odom_topic" value="lidar_slam/odom"/>
  <arg name="obj_num" value="0"/>

  <!-- 地图文件 -->
  <arg name="map_name" value="$(env HOME)/bagfiles/resource/plot2/Largeforest-2_38_32.pcd"/>
  <arg name="downsample_resolution" value="0.1"/>
  <arg name="use_uav_extra_model" value="0"/>

  <!-- 树干检测与配准参数 -->
  <arg name="enable_lidar_detect" value="true"/>
  <arg name="enable_graph_opt" value="true"/>

  <!-- ========================================================================
       1. 地图发布
       ======================================================================== -->
  <node pkg="lidar_map_generator" name="map_pub" type="map_pub" output="screen"
        args="$(arg map_name)">
    <param name="downsample_res" value="$(arg downsample_resolution)"/>
    <param name="map_offset_x" value="9.0"/>
    <param name="map_offset_y" value="-11.0"/>
    <param name="map_offset_z" value="-3.0"/>
  </node>

  <!-- ========================================================================
       2. UAV 1 (anchor)
       ======================================================================== -->
  <include file="$(find ego_planner)/launch_new/single_uav_lio.xml">
    <arg name="uav_id" value="$(arg uav_id_1)"/>
    <arg name="uav_num_" value="$(arg uav_num)"/>
    <arg name="lidar_type" value="mid360"/>
    <arg name="init_x" value="$(arg init_x)"/>
    <arg name="init_y" value="$(arg init_y)"/>
    <arg name="init_z" value="$(arg init_z)"/>
    <arg name="map_size_x" value="$(arg map_size_x)"/>
    <arg name="map_size_y" value="$(arg map_size_y)"/>
    <arg name="map_size_z" value="$(arg map_size_z)"/>
    <arg name="map_name" value="$(arg map_name)"/>
    <arg name="odom_topic" value="$(arg odom_topic)"/>
    <arg name="obj_num" value="$(arg obj_num)"/>
    <arg name="use_gpu" value="$(arg use_gpu_)"/>
    <arg name="downsample_resolution_" value="$(arg downsample_resolution)"/>
    <arg name="use_uav_extra_model_" value="$(arg use_uav_extra_model)"/>
    <arg name="box_min_x" value="0.0"/>
    <arg name="box_min_y" value="0.0"/>
    <arg name="box_min_z" value="2.0"/>
    <arg name="box_max_x" value="12.0"/>
    <arg name="box_max_y" value="6.0"/>
    <arg name="box_max_z" value="2.0"/>
    <arg name="step_X" value="3.0"/>
    <arg name="step_Y" value="3.0"/>
    <arg name="step_Z" value="2.0"/>
    <arg name="waypointDistriFlag" value="0"/>
    <arg name="grid_direction" value="0"/>
    <arg name="coordinate_X" value="1.5"/>
    <arg name="coordinate_Y" value="1.5"/>
    <arg name="minZ_rotate" value="2.0"/>
    <arg name="maxZ_rotate" value="10"/>
    <arg name="radius_R" value="1.7"/>
    <arg name="numSpiralSegments" value="4"/>
    <arg name="stepZ_rotate" value="0.5"/>
    <arg name="flight_type" value="3"/>
  </include>

  <group if="$(arg enable_lidar_detect)">
    <include file="$(find drone_detect_lidar)/launch/drone_detect_lidar.launch">
      <arg name="drone_id" value="$(arg uav_id_1)"/>
      <arg name="odom_topic" value="$(arg odom_topic)"/>
      <arg name="enable_graph_opt" value="$(arg enable_graph_opt)"/>
      <arg name="anchor_drone_id" value="$(arg uav_id_1)"/>
      <arg name="enable_relay" value="false"/>
    </include>
  </group>

  <!-- ========================================================================
       3. UAV 2
       ======================================================================== -->
  <include file="$(find ego_planner)/launch_new/single_uav_lio.xml">
    <arg name="uav_id" value="$(arg uav_id_2)"/>
    <arg name="uav_num_" value="$(arg uav_num)"/>
    <arg name="lidar_type" value="mid360"/>
    <arg name="init_x" value="3.0"/>
    <arg name="init_y" value="-3.0"/>
    <arg name="init_z" value="$(arg init_z)"/>
    <arg name="init_yaw" value="1.5708"/>
    <arg name="map_size_x" value="$(arg map_size_x)"/>
    <arg name="map_size_y" value="$(arg map_size_y)"/>
    <arg name="map_size_z" value="$(arg map_size_z)"/>
    <arg name="map_name" value="$(arg map_name)"/>
    <arg name="odom_topic" value="$(arg odom_topic)"/>
    <arg name="obj_num" value="$(arg obj_num)"/>
    <arg name="use_gpu" value="$(arg use_gpu_)"/>
    <arg name="downsample_resolution_" value="$(arg downsample_resolution)"/>
    <arg name="use_uav_extra_model_" value="$(arg use_uav_extra_model)"/>
    <arg name="box_min_x" value="3.0"/>
    <arg name="box_min_y" value="-3.0"/>
    <arg name="box_min_z" value="2.0"/>
    <arg name="box_max_x" value="9.0"/>
    <arg name="box_max_y" value="9.0"/>
    <arg name="box_max_z" value="3.0"/>
    <arg name="step_X" value="3.0"/>
    <arg name="step_Y" value="3.0"/>
    <arg name="step_Z" value="2.0"/>
    <arg name="waypointDistriFlag" value="0"/>
    <arg name="grid_direction" value="1"/>
    <arg name="coordinate_X" value="1.5"/>
    <arg name="coordinate_Y" value="1.5"/>
    <arg name="minZ_rotate" value="2.0"/>
    <arg name="maxZ_rotate" value="10"/>
    <arg name="radius_R" value="1.7"/>
    <arg name="numSpiralSegments" value="4"/>
    <arg name="stepZ_rotate" value="0.5"/>
    <arg name="flight_type" value="3"/>
  </include>

  <group if="$(arg enable_lidar_detect)">
    <include file="$(find drone_detect_lidar)/launch/drone_detect_lidar.launch">
      <arg name="drone_id" value="$(arg uav_id_2)"/>
      <arg name="odom_topic" value="$(arg odom_topic)"/>
      <arg name="enable_graph_opt" value="false"/>
      <arg name="enable_relay" value="false"/>
    </include>
  </group>

  <!-- ========================================================================
       4. UAV 3
       ======================================================================== -->
  <include file="$(find ego_planner)/launch_new/single_uav_lio.xml">
    <arg name="uav_id" value="$(arg uav_id_3)"/>
    <arg name="uav_num_" value="$(arg uav_num)"/>
    <arg name="lidar_type" value="mid360"/>
    <arg name="init_x" value="-3.0"/>
    <arg name="init_y" value="3.0"/>
    <arg name="init_z" value="$(arg init_z)"/>
    <arg name="init_yaw" value="-1.5708"/>
    <arg name="map_size_x" value="$(arg map_size_x)"/>
    <arg name="map_size_y" value="$(arg map_size_y)"/>
    <arg name="map_size_z" value="$(arg map_size_z)"/>
    <arg name="map_name" value="$(arg map_name)"/>
    <arg name="odom_topic" value="$(arg odom_topic)"/>
    <arg name="obj_num" value="$(arg obj_num)"/>
    <arg name="use_gpu" value="$(arg use_gpu_)"/>
    <arg name="downsample_resolution_" value="$(arg downsample_resolution)"/>
    <arg name="use_uav_extra_model_" value="$(arg use_uav_extra_model)"/>
    <arg name="box_min_x" value="-9.0"/>
    <arg name="box_min_y" value="0.0"/>
    <arg name="box_min_z" value="2.0"/>
    <arg name="box_max_x" value="-3.0"/>
    <arg name="box_max_y" value="9.0"/>
    <arg name="box_max_z" value="3.0"/>
    <arg name="step_X" value="3.0"/>
    <arg name="step_Y" value="3.0"/>
    <arg name="step_Z" value="2.0"/>
    <arg name="waypointDistriFlag" value="0"/>
    <arg name="grid_direction" value="2"/>
    <arg name="coordinate_X" value="1.5"/>
    <arg name="coordinate_Y" value="1.5"/>
    <arg name="minZ_rotate" value="2.0"/>
    <arg name="maxZ_rotate" value="10"/>
    <arg name="radius_R" value="1.7"/>
    <arg name="numSpiralSegments" value="4"/>
    <arg name="stepZ_rotate" value="0.5"/>
    <arg name="flight_type" value="3"/>
  </include>

  <group if="$(arg enable_lidar_detect)">
    <include file="$(find drone_detect_lidar)/launch/drone_detect_lidar.launch">
      <arg name="drone_id" value="$(arg uav_id_3)"/>
      <arg name="odom_topic" value="$(arg odom_topic)"/>
      <arg name="enable_graph_opt" value="false"/>
      <arg name="enable_relay" value="false"/>
    </include>
  </group>

  <!-- ========================================================================
       5. 通信桥接 (3机拓扑)
       ======================================================================== -->
  <!-- UAV1: 接收 UAV2 的 odom + tree_detection (用于 tree_loc_node A-B 配对) -->
  <node pkg="topic_tools" type="relay" name="uav2_to_uav1_odom_relay"
        args="/uav2/lidar_slam/odom /uav1/neighbor_odom"/>
  <node pkg="topic_tools" type="relay" name="uav2_to_uav1_tree_relay"
        args="/uav2/tree_detection /uav1/neighbor_tree_detection"/>

  <!-- UAV2: 接收 UAV1 的 odom + tree_detection (用于 tree_loc_node B-A 配对) -->
  <node pkg="topic_tools" type="relay" name="uav1_to_uav2_odom_relay"
        args="/uav1/lidar_slam/odom /uav2/neighbor_odom"/>
  <node pkg="topic_tools" type="relay" name="uav1_to_uav2_tree_relay"
        args="/uav1/tree_detection /uav2/neighbor_tree_detection"/>

  <!-- UAV3: 接收 UAV1 的 odom + tree_detection (用于 tree_loc_node C-A 配对) -->
  <node pkg="topic_tools" type="relay" name="uav1_to_uav3_odom_relay"
        args="/uav1/lidar_slam/odom /uav3/neighbor_odom"/>
  <node pkg="topic_tools" type="relay" name="uav1_to_uav3_tree_relay"
        args="/uav1/tree_detection /uav3/neighbor_tree_detection"/>

  <!-- tree_graph_node 需要接收所有 UAV 的 TreeRelativePose -->
  <!-- tree_loc_node 已发布到 /uav*/tree_relative_pose_msg，无需额外 relay -->

  <!-- ========================================================================
       6. RViz 可视化
       ======================================================================== -->
  <node name="rvizvisualisation" pkg="rviz" type="rviz" output="screen"
        args="-d $(find drone_detect_lidar)/rviz/lidar_detect.rviz"/>

</launch>
