<launch>
	<!-- 单机 -->
	<!-- 启动MAVROS -->
	<!-- 不同机载电脑,注意修改fcu_url至正确的端口号及波特率 -->
	<arg name="serial_port" default="/dev/ttyACM0"/>
	<arg name="gcs_ip" default="192.168.1.70"/>
	<!-- world 模式：本地 frame 改名为 uav1/fcu_local，配合 swarm_frame_adapter 转换到公共 world -->
	<arg name="enable_world_frame" default="false"/>

	<arg name="tfmini_id" default="0"/>
    <arg name="tfmini_fov" default="0.034906585"/>
    <!-- No automatic TF from unknown installation geometry; frame is namespaced. -->
    <group ns="uav1">
		<node pkg="mavros" type="mavros_node" name="mavros" output="screen">
			<param name="fcu_url" value="$(arg serial_port):57600" />
			<param name="gcs_url" value="udp://:14560@$(arg gcs_ip):14550"/>
			<!-- <param name="gcs_url" value="udp://:14560@localhost:14550" /> -->
			<param name="target_system_id" value="1" />
			<param name="target_component_id" value="1" />
			<param name="fcu_protocol" value="v2.0" />

			<!-- load blacklist, config -->
			<rosparam command="load" file="$(find mavros_bringup)/launch/px4_pluginlists.yaml" />
			<rosparam command="load" file="$(find mavros_bringup)/launch/px4_config.yaml" />
            <rosparam ns="distance_sensor/tfmini_down" subst_value="true">
              subscriber: false
              id: $(arg tfmini_id)
              frame_id: "uav1/tfmini_link"
              orientation: PITCH_270
              field_of_view: $(arg tfmini_fov)
              send_tf: false
            </rosparam>
			<param if="$(arg enable_world_frame)" name="local_position/frame_id" value="uav1/fcu_local"/>
			<param if="$(arg enable_world_frame)" name="local_position/tf/frame_id" value="uav1/fcu_local"/>
			<param if="$(arg enable_world_frame)" name="local_position/tf/child_frame_id" value="uav1/base_link"/>
			<param if="$(arg enable_world_frame)" name="imu/frame_id" value="uav1/base_link"/>
		</node>
	</group>

	<!-- run the rosbag.cpp -->
	<!-- <node pkg="rosbag" type="record" name="bag_record" output="screen" 
		args = "/uav1/prometheus/drone_state -o subset">	
	</node>	 -->
</launch>

